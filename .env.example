DISCORD_BOT_TOKEN=token
PORT=3535

# Restrict slash commands to one channel (optional — omit to allow commands anywhere)
COMMAND_CHANNEL_ID=

# Chess Engine backend URL (for /lichess and /analyze commands)
CHESS_ENGINE_URL=http://localhost:8000

# Health monitoring — set HEALTH_ALERT_CHANNEL_ID to enable background polling
# The bot will alert this channel when any service goes down or recovers
HEALTH_ALERT_CHANNEL_ID=

# DSS service URLs (used by /services command and health poller)
DSS_AUTH_URL=http://localhost:4000
DSS_DB_URL=http://localhost:4001
