# Discord Bot - dev
#
# Install on the droplet:
#   sudo cp discord-bot-dev.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now discord-bot-dev
#   journalctl -u discord-bot-dev -f       # watch logs
#
# To iterate live: `sudo systemctl stop discord-bot-dev`, run `bun run src/index.js`
# by hand in tmux, then `sudo systemctl start discord-bot-dev` when done.
#
# EDIT FOR YOUR DROPLET:
#   User=             account that owns the clone (run `which bun` as that user)
#   WorkingDirectory= the dev clone path; must contain its own .env and consumers.json
#   ExecStart=        absolute path to bun for that user (no PATH under systemd)
# Use a SEPARATE bot token, port, and HEALTH_ALERT_CHANNEL_ID in this clone's .env,
# or dev and prod will post duplicate messages as the same bot.

[Unit]
Description=Discord Bot (dev)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/srv/discordBot/dev
ExecStart=/root/.bun/bin/bun run src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
